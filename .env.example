# Copie para .env e preencha com os dados do seu banco.
# Em produção, defina estas variáveis no painel da plataforma (Railway, Render, etc).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=amigo_secreto

# Porta do servidor. Em produção a plataforma injeta PORT automaticamente.
PORT=3000
